ommit & pushrules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══ Funcții ajutătoare ═══════════════════════════════════
    function signedIn()  { return request.auth != null; }
    function profPath()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function accPath()   { return /databases/$(database)/documents/acces/$(request.auth.uid); }

    // Cont activ = există profil users/{uid} și nu e dezactivat
    function isActive()  { return signedIn() && exists(profPath()) && get(profPath()).data.get('activ', true) != false; }
    // Administrator general = users/{uid}.rol == 'admin'
    function isAdmin()   { return isActive() && get(profPath()).data.get('rol', 'manager') == 'admin'; }
    // Are acces pe cel puțin un imobil (document acces/{uid})
    function hasAcc()    { return isActive() && exists(accPath()); }
    function acc()       { return get(accPath()).data; }
    function canAny()    { return isAdmin() || hasAcc(); }

    // Acces la o firmă emitentă: persoana e în lista acces[] a entității (decisă de administrator)
    function entPath(eid) { return /databases/$(database)/documents/entitati_emitente/$(eid); }
    function entAcc(eid) {
      return isActive() && eid is string && exists(entPath(eid))
        && request.auth.uid in get(entPath(eid)).data.get('acces', []);
    }

    // Nivelul pe un imobil: 0 fără acces · 1 vizualizare · 2 operare · 3 administrare
    function nivel(imobilId) {
      return (hasAcc() && imobilId is string && (imobilId in acc().get('imobile', {})))
        ? acc().imobile[imobilId] : 0;
    }

    // Documente care poartă câmpul imobilId
    function rd(min) { return isAdmin() || nivel(resource.data.imobilId) >= min; }
    function wr(min) { return isAdmin() || nivel(request.resource.data.imobilId) >= min; }

    // ══ Utilizatori ══════════════════════════════════════════
    match /users/{userId} {
      allow get:    if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list:   if isAdmin();
      // Conturile se creează doar de administrator (funcția Netlify, prin Admin SDK)
      allow create: if isAdmin();
      // Oricine își poate schimba doar apelativul propriu
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apelativ']));
      allow delete: if isAdmin();
    }

    // ══ Acces pe imobil ══════════════════════════════════════
    // Doar administratorul general acordă / retrage accesul (bifă pe imobil în aplicație).
    match /acces/{userId} {
      allow get:    if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list:   if isAdmin();
      allow write:  if isAdmin();
    }

    // ══ Imobile ══════════════════════════════════════════════
    match /imobile/{imobilId} {
      allow get:    if isAdmin() || nivel(imobilId) >= 1;
      allow list:   if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || nivel(imobilId) >= 3;
    }
    match /preturi_imobil/{imobilId} {
      allow get:    if isAdmin() || nivel(imobilId) >= 1;
      allow write:  if isAdmin() || nivel(imobilId) >= 3;
    }

    // ══ Date legate de imobil (câmpul imobilId pe fiecare document) ══
    match /spatii/{id} {
      allow read:   if rd(1);
      allow create: if wr(3);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(3);
    }
    match /contoare/{id} {
      allow read:   if rd(1);
      allow create: if wr(2);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(2);
    }
    match /citiri/{id} {
      allow read:   if rd(1);
      allow create: if wr(2);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(2);
    }
    match /registru_contracte/{id} {
      allow read:   if rd(1);
      allow create: if wr(2);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(3);
    }
    // Firmele care facturează: le văd doar persoanele din acces[]; le configurează doar administratorul (fără chei secrete aici)
    match /entitati_emitente/{id} {
      allow read:  if isAdmin() || (isActive() && request.auth.uid in resource.data.get('acces', []));
      allow write: if isAdmin();
    }
    // Evidența chiriilor facturate lunar (câte un document pe contract și lună): acces pe imobil ȘI pe firmă
    match /facturari_lunare/{id}  {
      allow read:   if isAdmin() || (rd(1) && entAcc(resource.data.get('entitateId', null)));
      allow create: if isAdmin() || (wr(2) && entAcc(request.resource.data.get('entitateId', null)));
      allow update: if isAdmin() || (rd(2) && wr(2) && entAcc(resource.data.get('entitateId', null)));
      allow delete: if isAdmin() || (rd(2) && entAcc(resource.data.get('entitateId', null)));
    }
    // Istoric modificări: orice cont activ scrie (doar în numele lui), citește doar administratorul, nimeni nu modifică / șterge
    match /audit/{id} {
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }
    match /note_calcul/{id}       { allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }
    match /templates_nota/{id}    { allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }
    match /istoric_spatiu/{id}    { allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }
    match /contracte_drafturi/{id}{ allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }
    // Documente: pe imobil (clienți, imobile) sau pe firmă emitentă (entityType == 'entitate', fără imobil)
    match /documente/{id} {
      allow read:   if rd(1) || (resource.data.get('entityType', '') == 'entitate' && entAcc(resource.data.get('entityId', null)));
      allow create: if wr(2) || (request.resource.data.get('entityType', '') == 'entitate' && entAcc(request.resource.data.get('entityId', null)));
      allow update: if (rd(2) && wr(2)) || (resource.data.get('entityType', '') == 'entitate' && entAcc(resource.data.get('entityId', null)));
      allow delete: if rd(2) || (resource.data.get('entityType', '') == 'entitate' && entAcc(resource.data.get('entityId', null)));
    }
    match /note/{id}              { allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }
    match /emailuri/{id}          { allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }
    match /comunicari/{id}        { allow read: if rd(1); allow create: if wr(2); allow update: if rd(2) && wr(2); allow delete: if rd(2); }

    // ══ Clienți ══════════════════════════════════════════════
    // Clientul poartă lista „imobile”. NOTĂ: Firestore nu poate filtra o listare după o listă dinamică,
    // așa că listarea e permisă oricărui utilizator cu acces; aplicația afișează doar clienții imobilelor lui.
    // Citirea unui client individual, scrierea și ștergerea sunt strict pe imobil.
    match /clienti/{id} {
      allow get:    if isAdmin() || (hasAcc() && resource.data.get('imobile', []).hasAny(acc().get('imobile', {}).keys()));
      allow list:   if isAdmin() || hasAcc();
      allow create: if isAdmin() || (hasAcc() && request.resource.data.imobile.size() > 0
                        && nivel(request.resource.data.imobile[0]) >= 2);
      allow update: if isAdmin() || (hasAcc() && (
                          (resource.data.get('imobile', []).size() > 0 && nivel(resource.data.imobile[0]) >= 2)
                       || (resource.data.get('imobile', []).size() > 0 && nivel(resource.data.imobile[resource.data.imobile.size() - 1]) >= 2)
                       || (request.resource.data.imobile.size() > 0
                           && nivel(request.resource.data.imobile[request.resource.data.imobile.size() - 1]) >= 2)));
      allow delete: if isAdmin() || (hasAcc() && resource.data.get('imobile', []).size() > 0
                        && nivel(resource.data.imobile[0]) >= 3);
    }

    // ══ Portal chiriași (acces public prin token) ════════════
    // Documentul portalului are ID = token. Chiriașul îl poate citi doar dacă știe tokenul; colecția nu se listează public.
    function portalPath(d) { return /databases/$(database)/documents/portale/$(d.token); }
    function portalOk(d) {
      return d.token is string && exists(portalPath(d))
        && get(portalPath(d)).data.get('activ', true) == true
        && (get(portalPath(d)).data.get('valabilPanaTs', null) == null
            || request.time < get(portalPath(d)).data.valabilPanaTs)
        && d.spatiuId == get(portalPath(d)).data.spatiuId
        && d.imobilId == get(portalPath(d)).data.imobilId;
    }
    match /portale/{token} {
      allow get:    if true;
      allow list:   if rd(1);
      allow create: if wr(2);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(2);
    }
    match /indexuri_primite/{id} {
      allow create: if portalOk(request.resource.data)
                      && request.resource.data.status == 'asteptare'
                      && request.resource.data.indexNou is number
                      && request.resource.data.keys().hasOnly(['token', 'spatiuId', 'imobilId', 'contorId', 'tip', 'um',
                           'indexNou', 'indexPrecedent', 'consum', 'status', 'avePoza', 'dataTrimis']);
      allow read:   if rd(1);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(2);
    }
    match /cereri_portal/{id} {
      allow create: if portalOk(request.resource.data)
                      && request.resource.data.status == 'nou'
                      && request.resource.data.tip in ['sesizare', 'informare', 'document']
                      && request.resource.data.text is string && request.resource.data.text.size() <= 3000
                      && request.resource.data.fisiere is list && request.resource.data.fisiere.size() <= 5
                      && request.resource.data.keys().hasOnly(['token', 'spatiuId', 'imobilId', 'tip', 'text', 'fisiere',
                           'chiriasNume', 'contact', 'status', 'dataTrimis']);
      allow read:   if rd(1);
      allow update: if rd(2) && wr(2);
      allow delete: if rd(3);
    }

    // ══ Configurări comune ═══════════════════════════════════
    // Semnalul „configurarea inițială s-a făcut” — citibil de orice cont autentificat (ca să-și poată crea profilul)
    match /config/{docId}              { allow read: if canAny(); allow write: if isAdmin(); }
    match /serii_contracte/{docId}     { allow read, write: if canAny(); }
    match /templates_contracte/{docId} { allow read: if canAny(); allow write: if isAdmin(); }
    match /expeditori_email/{docId}    { allow read, write: if canAny(); }
    match /template_email/{docId}      { allow read, write: if canAny(); }

    // ── Orice altă colecție — blocată ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
